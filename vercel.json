{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/backend/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/packers-and-movers-in-(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=86400, stale-while-revalidate" }
      ]
    }
  ]
}
